# Copy this file to .env and edit model names/URLs to match the models supplied.

# Local text/code model: ollama or openai_compatible (for a local vLLM endpoint)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:3b

# Embedding model used by ChromaDB. This is separate from the coding model.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional local vLLM/OpenAI-compatible coding endpoint
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=EMPTY
OPENAI_COMPAT_MODEL=local-coder

# Vision backend: ollama or openai_compatible
VISION_BACKEND=ollama
OLLAMA_VISION_MODEL=llava-phi3
VISION_OPENAI_BASE_URL=http://localhost:8001/v1
VISION_OPENAI_API_KEY=EMPTY
VISION_OPENAI_MODEL=local-vision

# RAG settings
CHROMA_COLLECTION=offline_cv_docs
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
MAX_DOC_CONTEXT_CHARS=18000

# Execution settings
MAX_RETRIES=3
EXECUTION_TIMEOUT=90
WORKSPACE_DIR=./workspace
OUTPUT_DIR=./outputs
ENABLE_CODE_SAFETY_CHECK=true
